---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="zh">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			body {
				font-family: system-ui, sans-serif;
				max-width: 680px;
				margin: 0 auto;
				padding: 2rem 1rem;
				color: #111;
			}
			header {
				margin-bottom: 3rem;
			}
			header h1 {
				font-size: 1.4rem;
				margin: 0;
			}
			header h1 a {
				text-decoration: none;
				color: #111;
			}
			.back {
				display: inline-block;
				font-size: 0.9rem;
				color: #888;
				text-decoration: none;
				margin-bottom: 2rem;
			}
			.back:hover { color: #2563eb; }
			.post-title {
				font-size: 1.8rem;
				font-weight: 700;
				margin: 0 0 0.5rem 0;
				line-height: 1.3;
			}
			.date {
				font-size: 0.875rem;
				color: #888;
				margin-bottom: 2.5rem;
			}
			.prose {
				line-height: 1.75;
				font-size: 1rem;
			}
			.prose h2 { font-size: 1.3rem; margin-top: 2rem; }
			.prose h3 { font-size: 1.1rem; margin-top: 1.5rem; }
			.prose p { margin: 1rem 0; }
			.prose a { color: #2563eb; }
			.prose hr { border: none; border-top: 1px solid #eee; margin: 2rem 0; }
		</style>
	</head>
	<body>
		<header>
			<h1>Shicheng Huang</h1>
		</header>
		<main>
			<a class="back" href={`${base}/blog/`}>← 所有文章</a>
			<h1 class="post-title">{title}</h1>
			<div class="date">
				<FormattedDate date={pubDate} />
				{updatedDate && <span>（更新于 <FormattedDate date={updatedDate} />）</span>}
			</div>
			<div class="prose">
				<slot />
			</div>
		</main>
	</body>
</html>
